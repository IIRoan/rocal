+func serverTimingDuration(headers []string, metric string) (time.Duration, bool) {
+	for _, header := range headers {
+		for _, item := range strings.Split(header, ",") {
+			name, params, _ := strings.Cut(item, ";")
+			if strings.TrimSpace(name) != metric {
+				continue
+			}
+			for _, param := range strings.Split(params, ";") {
+				key, value, _ := strings.Cut(param, "=")
+				if strings.TrimSpace(key) != "dur" {
+					continue
+				}
+				ms, err := strconv.ParseFloat(strings.Trim(strings.TrimSpace(value), `"`), 64)
+				if err == nil && ms >= 0 && ms < float64(1<<63)/float64(time.Millisecond) {
+					return time.Duration(ms * float64(time.Millisecond)), true
+				}
+			}
+		}
+	}
+	return 0, false
+}
