{
  "name": "native",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated@~4.1.1"
      ]
    }
  },
  "scripts": {
    "dev": "bun run ./scripts/dev.ts",
    "dev:expo": "expo start",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:dev:android": "eas build --platform android --profile development",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "update:master": "eas update --branch master",
    "update:testing": "eas update --branch testing",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest -c jest.config.cjs",
    "test:coverage": "jest -c jest.config.cjs --coverage",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@better-auth/expo": "^1.5.5",
    "@better-auth/passkey": "^1.5.5",
    "@noble/hashes": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.90.0",
    "@workspace/calendar-client": "workspace:*",
    "@workspace/calendar-core": "workspace:*",
    "@workspace/design-tokens": "workspace:*",
    "@workspace/e2ee": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/runtime": "workspace:*",
    "better-auth": "^1.5.5",
    "date-fns": "^4.1.0",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-haptics": "~15.0.8",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "node-forge": "^1.4.0",
    "openpgp": "^6.3.0",
    "postal-mime": "^2.7.4",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-quick-base64": "^3.0.0",
    "react-native-quick-crypto": "^1.1.5",
    "react-native-reanimated": "~3.19.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.4.1",
    "@types/jest": "29.5.14",
    "@types/node-forge": "^1.3.14",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~10.0.0",
    "fast-check": "^4.7.0",
    "jest": "~29.7.0",
    "typescript": "~5.9.2"
  }
}
