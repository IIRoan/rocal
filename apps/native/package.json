{
  "name": "native",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "bun run ./scripts/dev.ts",
    "dev:expo": "APP_VARIANT=development expo start --dev-client",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:dev:android": "eas build --platform android --profile development",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "update:development": "APP_VARIANT=development eas update --branch development --environment development",
    "update:preview": "APP_VARIANT=preview eas update --branch preview --environment preview",
    "update:testing": "APP_VARIANT=preview eas update --branch testing --environment preview",
    "update:master": "APP_VARIANT=production eas update --branch master --environment production",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest -c jest.config.cjs",
    "test:coverage": "jest -c jest.config.cjs --coverage",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.13",
    "@better-auth/passkey": "^1.6.13",
    "@blobatar/react-native": "^2.5.0",
    "@expo/vector-icons": "^15.0.2",
    "@howljs/calendar-kit": "^2.5.6",
    "@noble/hashes": "^2.2.0",
    "@tanstack/react-query": "^5.90.0",
    "@workspace/calendar-client": "workspace:*",
    "@workspace/calendar-core": "workspace:*",
    "@workspace/design-tokens": "workspace:*",
    "@workspace/e2ee": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/runtime": "workspace:*",
    "better-auth": "^1.6.13",
    "blobatar": "^2.5.0",
    "date-fns": "^4.1.0",
    "expo": "~57.0.13",
    "expo-build-properties": "~57.0.11",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.12",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.14",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.14",
    "expo-web-browser": "~57.0.2",
    "node-forge": "^1.4.0",
    "openpgp": "^6.3.0",
    "postal-mime": "^2.7.4",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-quick-base64": "^3.0.0",
    "react-native-quick-crypto": "^1.1.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.4.1",
    "@types/jest": "29.5.14",
    "@types/node-forge": "^1.3.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.1",
    "fast-check": "^4.7.0",
    "jest": "~29.7.0",
    "typescript": "~6.0.3"
  }
}
