# Frontend URL (public)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend API URL (public)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Native app auth callback (Capacitor deep link)
NEXT_PUBLIC_MOBILE_AUTH_CALLBACK_URL="app.solace.onl://api/auth"
# For Android emulator you can set: http://10.0.2.2:3001
# For a real phone on LAN, set this to your machine IP (example): http://192.168.1.42:3001

# Optional comma-separated extra origins allowed by backend auth/cors.
# Include mobile webview origins when testing Capacitor locally.
# TRUSTED_ORIGINS="capacitor://localhost,http://localhost,https://localhost"

# GitHub OAuth (required for Better Auth redirects)
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Auth Secret (shared with backend)
BETTER_AUTH_SECRET="your_secret_key_here"

NODE_ENV="development"
