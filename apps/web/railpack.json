{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "bun": "latest"
  },
  "caches": {
    "bun-cache": {
      "directory": "/root/.bun/install/cache",
      "type": "shared"
    },
    "next-cache": {
      "directory": "apps/web/.next/cache",
      "type": "shared"
    }
  },
  "steps": {
    "install": {
      "commands": [
        { "cmd": "bun install --frozen-lockfile" }
      ],
      "caches": ["bun-cache"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        { "cmd": "bun run --filter=web build" },
        { "cmd": "mkdir -p apps/web/.next/standalone/apps/web/.next && cp -r apps/web/.next/static apps/web/.next/standalone/apps/web/.next/" },
        { "cmd": "mkdir -p apps/web/.next/standalone/apps/web && cp -r apps/web/public apps/web/.next/standalone/apps/web/" }
      ],
      "caches": ["next-cache"]
    }
  },
  "deploy": {
    "inputs": [
      {
        "step": "build",
        "include": [
          "apps/web/.next/standalone/**"
        ]
      }
    ],
    "startCommand": "cd apps/web/.next/standalone && bun apps/web/server.js",
    "variables": {
      "NODE_ENV": "production",
      "PORT": "3000",
      "HOSTNAME": "0.0.0.0"
    }
  }
}
