    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ionic/react": "^8.8.1",
    "@openrouter/ai-sdk-provider": "^2.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@swc/helpers": "^0.5.17",
    "@tanstack/react-query": "^5.90.12",
    "@workspace/logger": "0.10.0",
    "ai": "^6.0.116",
    "better-auth": "^1.5.5",
    "better-call": "^2.0.2",
    "class-variance-authority": "^0.7.1",
