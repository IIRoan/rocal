{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "ionic:serve": "bun run mobile:dev",
    "ionic:build": "bun run build",
    "mobile:dev": "bun --bun next dev --hostname 0.0.0.0 --port 3000",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "mobile:build": "bun run build",
    "mobile:copy": "bunx cap copy",
    "mobile:sync": "bun run mobile:build && bunx cap sync",
    "mobile:ios": "bun run mobile:sync && bunx cap run ios",
    "mobile:open:ios": "bunx cap open ios",
    "mobile:ios:live": "ionic cap run ios -l --external",
    "mobile:android": "bun run mobile:sync && bunx cap run android",
    "mobile:open:android": "bunx cap open android",
    "mobile:android:devices": "adb devices",
    "mobile:android:live": "ionic cap run android -l --external",
    "mobile:android:live:usb": "ionic cap run android -l --external",
    "mobile:android:live:emu": "ionic cap run android -l --host=10.0.2.2 --port=3000",
    "mobile:dev:wifi": "bun run ./scripts/mobile-dev-wifi.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
