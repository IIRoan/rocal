{
  "name": "native-mail",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "eas-build-pre-install": "node ../../packages/native-core/expo-config.cjs --check-environment",
    "dev": "bun run ./scripts/dev.ts",
    "dev:expo": "APP_VARIANT=development expo start --dev-client",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:dev:android": "eas build --platform android --profile development",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:testing:ios": "eas build --platform ios --profile testing",
    "build:testing:android": "eas build --platform android --profile testing",
    "build:testflight:ios": "eas build --platform ios --profile testflight",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "update:development": "bun run ./scripts/publish-update.ts development",
    "update:preview": "bun run ./scripts/publish-update.ts preview",
    "update:testing": "bun run ./scripts/publish-update.ts testing",
    "update:production": "bun run ./scripts/publish-update.ts production",
    "update:master": "bun run ./scripts/publish-update.ts production",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.jest.json",
    "test": "jest -c jest.config.cjs",
    "test:coverage": "jest -c jest.config.cjs --coverage",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.15",
    "@better-auth/passkey": "^1.7.15",
    "@blobatar/react-native": "^2.7.0",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "^5.105.0",
    "@workspace/calendar-client": "workspace:*",
    "@workspace/calendar-core": "workspace:*",
    "@workspace/design-tokens": "workspace:*",
    "@workspace/e2ee": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/native-core": "workspace:*",
    "@workspace/runtime": "workspace:*",
    "better-auth": "^1.7.15",
    "blobatar": "^2.7.0",
    "date-fns": "^4.4.0",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "openpgp": "^6.3.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.9",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.4.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~58.0.4",
    "fast-check": "^4.10.2",
    "jest": "~30.5.2",
    "typescript": "~6.0.3"
  }
}
