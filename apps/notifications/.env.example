# Shared with apps/backend — `go run ./` also loads ../backend/.env when this file is missing.
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Transactional reminder mail (Stalwart JMAP as the noreply identity)
STALWART_JMAP_URL="https://mail.solace.onl"
STALWART_JMAP_USERNAME="noreply@solace.onl"
STALWART_JMAP_PASSWORD=""
EMAIL_FROM="noreply@solace.onl"
EMAIL_FROM_NAME="Solace"

# HTTP listen port (defaults to 4002 if unset)
PORT="4002"

# Optional: public site used in reminder links
FRONTEND_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:4000"

# APNs (lock-screen push for Solace Dev = sandbox). One .p8 works for both App IDs.
# Create the key at https://developer.apple.com/account/resources/authkeys/list
# APNS_KEY_ID="ABCDE12345"
# APNS_TEAM_ID="FGHIJ67890"
# APNS_AUTH_KEY_FILE="./AuthKey.p8"
# Or paste the PEM (including BEGIN/END lines) into APNS_AUTH_KEY.
