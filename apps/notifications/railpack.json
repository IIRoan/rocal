{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "bun": "latest"
  },
  "caches": {
    "bun-cache": {
      "directory": "/root/.bun/install/cache",
      "type": "shared"
    }
  },
  "steps": {
    "install": {
      "commands": [
        { "cmd": "bun install --frozen-lockfile" }
      ],
      "caches": ["bun-cache"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        { "cmd": "bun run --filter=notifications prisma:generate" },
        { "cmd": "bun run --filter=notifications typecheck" }
      ]
    }
  },
  "deploy": {
    "inputs": [
      { "step": "build", "include": ["apps/notifications/**", "node_modules/**", "packages/**"] }
    ],
    "startCommand": "bun apps/notifications/server.ts",
    "variables": {
      "NODE_ENV": "production"
    }
  }
}
