EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_APP_URL=https://app.example.com
# PASSKEY_ORIGIN=https://another-passkey-origin.example.com
# Optional fork overrides; normal development uses the shared project identity.
# EXPO_OWNER=your-expo-account-or-org
# EXPO_PROJECT_ID=your-eas-project-id
# EXPO_PROJECT_SLUG=your-eas-project-slug

# development | preview | production — development uses Solace Dev icon + .dev bundle ID
APP_VARIANT=development

# Optional local native dev tunnel defaults used by `bun run dev`.
CLOUDFLARED_PUBLIC_URL=https://cloudflared.roan.dev
CLOUDFLARED_TUNNEL_NAME=rocal
# CLOUDFLARED_CONFIG=/Users/you/.cloudflared/config.yml
# CLOUDFLARED_TUNNEL_TOKEN=your-cloudflare-tunnel-token
