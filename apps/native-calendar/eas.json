{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "bun": "1.4.4",
      "node": "22.23.4",
      "env": {
        "APP_VARIANT": "development",
        "SOLACE_ENV_SOURCE": "eas"
      },
      "ios": {
        "image": "sdk-57"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "bun": "1.4.4",
      "node": "22.23.4",
      "env": {
        "APP_VARIANT": "preview",
        "SOLACE_ENV_SOURCE": "eas"
      },
      "ios": {
        "image": "sdk-57"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "master",
      "autoIncrement": true,
      "environment": "production",
      "bun": "1.4.4",
      "node": "22.23.4",
      "env": {
        "APP_VARIANT": "production",
        "SOLACE_ENV_SOURCE": "eas"
      },
      "ios": {
        "image": "sdk-57"
      }
    },
    "testing": {
      "extends": "preview",
      "channel": "testing"
    },
    "testflight": {
      "extends": "production",
      "channel": "testing",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "preview"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6828036308"
      }
    }
  }
}
