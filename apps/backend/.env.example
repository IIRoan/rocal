# Database
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Transactional mail (Stalwart JMAP submission as the noreply identity)
STALWART_JMAP_URL="https://mail.solace.onl"
STALWART_JMAP_USERNAME="noreply@solace.onl"
STALWART_JMAP_PASSWORD=""
EMAIL_FROM="noreply@solace.onl"
EMAIL_FROM_NAME="Solace"

# GitHub OAuth
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Backend Server Configuration
PORT="4001"
BACKEND_URL="http://localhost:4001"
FRONTEND_URL="http://localhost:4000"
# GitHub must allow: ${BACKEND_URL}/api/auth/callback/github
AUTH_REDIRECT_URL="http://localhost:4000"
MOBILE_AUTH_CALLBACK_URL="solace://api/auth"
# Solace Dev (`solace-dev://`) is trusted automatically; no extra origin is required.

# Comma-separated list of additional trusted origins for auth + CORS.
# Useful for local development URLs and staging hosts.
TRUSTED_ORIGINS="http://localhost,https://localhost"

# Session cookie sameSite policy.
# Use "none" for cross-site native webview auth over HTTPS.
AUTH_COOKIE_SAME_SITE="lax"

# Production example:
# BACKEND_URL="https://calback.roan.dev"
# FRONTEND_URL="https://cal.roan.dev"

NODE_ENV="development"
AUTH_SKIP_STATE_COOKIE_CHECK="true"

# Auth Secret
BETTER_AUTH_SECRET="your_secret_key_here"

# Stalwart / JMAP (mail server) configuration
# Base URL for Stalwart HTTPS/JMAP access. Use the public 443 origin, not :8080.
STALWART_BASE_URL="https://mail.solace.onl"
# Default domain used when provisioning demo mailboxes
STALWART_DEFAULT_DOMAIN="solace.onl"
# Admin token for Stalwart provisioning (REQUIRED in production).
# Rotate it if it was ever used over plain HTTP on a public endpoint.
STALWART_ADMIN_TOKEN=""
# HMAC secret Stalwart uses to sign message-ingest.ham webhooks (X-Signature).
STALWART_WEBHOOK_SECRET=""
# Optional override; defaults to ${BACKEND_URL}/api/internal/stalwart/webhook
# STALWART_WEBHOOK_URL="https://api.example.com/api/internal/stalwart/webhook"

# Frontend public fallbacks used by backend
NEXT_PUBLIC_APP_URL="http://localhost:4000"
NEXT_PUBLIC_MOBILE_AUTH_CALLBACK_URL="solace://api/auth"
