# The API reads these at boot (`src/config.rs`); the notifications worker also loads this file.
# Pending migrations are applied to DATABASE_URL at startup.
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"
# DATABASE_POOL_SIZE="10"

PORT="4001"
NODE_ENV="development"
BACKEND_URL="http://localhost:4001"
FRONTEND_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:4000"
# Defaults to NEXT_PUBLIC_APP_URL.
# PASSKEY_ORIGIN="http://localhost:4000"
MOBILE_AUTH_CALLBACK_URL="solace://api/auth"
NEXT_PUBLIC_MOBILE_AUTH_CALLBACK_URL="solace://api/auth"
# Extra trusted origins for auth and CORS, comma-separated; the apps' deep links are trusted by default.
TRUSTED_ORIGINS="http://localhost,https://localhost"
# "none" for cross-site native webview auth over HTTPS.
AUTH_COOKIE_SAME_SITE="lax"
BETTER_AUTH_SECRET="your_secret_key_here"

# App mail goes out over JMAP as the noreply identity.
STALWART_JMAP_URL="https://mail.solace.onl"
STALWART_JMAP_USERNAME="noreply@solace.onl"
STALWART_JMAP_PASSWORD=""
EMAIL_FROM="noreply@solace.onl"
EMAIL_FROM_NAME="Solace"

# Stalwart: unset STALWART_* falls back to production, so set them all when running against a copy.
STALWART_BASE_URL="https://mail.solace.onl"
STALWART_DEFAULT_DOMAIN="solace.onl"
# Token of the scoped `solace-provisioner` role, never an admin token; mailbox data is read as the owner.
STALWART_PROVISION_TOKEN=""
# HMAC secret Stalwart signs message-ingest webhooks with.
STALWART_WEBHOOK_SECRET=""
# Key the Railway backend gate requires.
STALWART_GATE_KEY=""
# Operator-only Stalwart admin access: allowed user ids and the authorizer's key.
STALWART_ADMIN_USER_IDS=""
STALWART_ADMIN_GATE_KEY=""
# Base64 secret deriving each user's Stalwart bridge password.
MAIL_BRIDGE_HMAC_KEY=""
# MAIL_RECEIPT_POLLING="false"
# CALENDAR_SYNC="true"

# Private Railway bucket for uploaded profile pictures (`railway bucket credentials --bucket profile-pictures`).
AVATAR_BUCKET=""
AVATAR_BUCKET_ENDPOINT="https://t3.storageapi.dev"
AVATAR_BUCKET_REGION="auto"
AVATAR_BUCKET_ACCESS_KEY_ID=""
AVATAR_BUCKET_SECRET_ACCESS_KEY=""
