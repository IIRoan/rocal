# Database
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Email service (required for email notifications)
RESEND_API_KEY="your_resend_api_key_here"

# GitHub OAuth
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Backend Server Configuration
PORT="3001"
BACKEND_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"
AUTH_REDIRECT_URL="http://localhost:3000"
MOBILE_AUTH_CALLBACK_URL="app.solace.onl://api/auth"

# Comma-separated list of additional trusted origins for auth + CORS.
# Useful for Capacitor local origins and LAN dev URLs.
TRUSTED_ORIGINS="capacitor://localhost,http://localhost,https://localhost"

# Session cookie sameSite policy.
# Use "none" for cross-site native webview auth over HTTPS.
AUTH_COOKIE_SAME_SITE="lax"

# Production example:
# BACKEND_URL="https://calback.roan.dev"
# FRONTEND_URL="https://cal.roan.dev"

NODE_ENV="development"
AUTH_SKIP_STATE_COOKIE_CHECK="true"

# Auth Secret
BETTER_AUTH_SECRET="your_secret_key_here"
