{
  "name": "backend",
  "type": "module",
  "scripts": {
    "build": "prisma generate && bun build --compile --minify-whitespace --minify-syntax --target bun-linux-x64 --outfile server index.ts",
    "dev": "bun --watch index.ts",
    "start": "./server",
    "start:dev": "bun index.ts",
    "typecheck": "tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset"
  },
  "devDependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "@types/node": "^20",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "prisma": "^6.12.0",
    "typescript": "5"
  },
  "dependencies": {
    "@better-auth/core": "^1.5.5",
    "@better-auth/passkey": "^1.5.5",
    "@better-auth/utils": "^0.3.1",
    "@better-fetch/fetch": "^1.1.21",
    "@elysiajs/cors": "^1.3.3",
    "@prisma/client": "^6.12.0",
    "@react-email/components": "^0.4.0",
    "@react-email/render": "^1.1.4",
    "@types/ical": "^0.8.3",
    "better-auth": "^1.5.5",
    "better-call": "^2.0.2",
    "date-fns": "^4.1.0",
    "elysia": "1",
    "ical": "^0.8.0",
    "node-ical": "^0.20.1",
    "prismabox": "^1.1.24",
    "react": "^19.2.1",
    "resend": "^4.7.0"
  }
}
