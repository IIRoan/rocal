{
  "name": "backend",
  "type": "module",
  "scripts": {
    "build": "prisma generate && bun build --compile --minify-whitespace --minify-syntax --target bun-linux-x64 --outfile server index.ts",
    "dev": "bun --watch index.ts",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "./server",
    "start:dev": "bun index.ts",
    "test": "jest --config ./jest.config.cjs",
    "test:coverage": "jest --config ./jest.config.cjs --coverage --runInBand",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "validate": "bun run lint && bun run typecheck && bun run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@workspace/eslint-config": "workspace:*",
    "@elysiajs/swagger": "^1.3.1",
    "@types/node": "^20",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^16.4.0",
    "prisma": "^6.12.0",
    "prismabox": "^1.1.26",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.1"
  },
  "dependencies": {
    "@better-auth/core": "^1.6.13",
    "@better-auth/expo": "^1.6.13",
    "@better-auth/oauth-provider": "1.6.13",
    "@better-auth/passkey": "^1.6.13",
    "@better-auth/utils": "^0.4.1",
    "@better-fetch/fetch": "^1.1.21",
    "@elysiajs/cors": "^1.3.3",
    "@prisma/client": "^6.12.0",
    "@react-email/render": "^1.1.4",
    "@types/ical": "^0.8.3",
    "@workspace/calendar-core": "workspace:*",
    "@workspace/calendar-ics": "workspace:*",
    "@workspace/logger": "0.10.0",
    "@workspace/runtime": "workspace:*",
    "better-auth": "^1.6.13",
    "better-call": "^2.0.2",
    "elysia": "1",
    "ical": "^0.8.0",
    "openpgp": "^6.3.0",
    "react": "19.2.3",
    "zod": "^3.25.76"
  }
}
