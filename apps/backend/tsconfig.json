{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@workspace/calendar-ics": ["../../packages/calendar-ics/src/index.ts"],
      "@workspace/calendar-ics/*": ["../../packages/calendar-ics/src/*"]
    }
  },
  "include": ["**/*.ts", "../../packages/calendar-ics/src/**/*.ts"]
}
