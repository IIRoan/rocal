{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "bun": "latest"
  },
  "steps": {
    "install": {
      "commands": [
        { "cmd": "bun install" }
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        { "cmd": "bun run db:generate" }
      ]
    }
  },
  "deploy": {
    "inputs": [
      {
        "step": "build",
        "include": [
          "**",
          "!node_modules"
        ]
      }
    ],
    "startCommand": "bun run start",
    "variables": {
      "NODE_ENV": "production",
      "PORT": "3001",
      "HOSTNAME": "0.0.0.0"
    }
  }
}
