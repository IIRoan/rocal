
generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

generator prismabox {
  provider                    = "prismabox"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
  inputModel                  = true
  output                      = "../generated/prismabox"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(cuid())
  name           String
  email          String             @unique
  emailVerified  Boolean            @default(false) @map("email_verified")
  image          String?
  hasAiAccess    Boolean            @default(false) @map("has_ai_access")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  sessions       Session[]
  accounts       Account[]
  // Calendar relationships
  events         CalendarEvent[]
  categories     EventCategory[]
  calendars      Calendar[]
  participations EventParticipant[]
  settings       UserSettings?
  subscriptions  CalendarSubscription[]

  passkeys Passkey[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String    @unique
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("verification")
}

// Calendar Models

model Calendar {
  id              String            @id @default(cuid())
  name            String
  color           String // blue, orange, violet, rose, emerald
  isVisible       Boolean           @default(true) @map("is_visible")
  isDefault       Boolean           @default(false) @map("is_default")
  isSyncOnly      Boolean           @default(false) @map("is_sync_only") // Read-only calendar synced from external subscription
  icsShareToken   String?           @unique @map("ics_share_token")
  icsShareEnabled Boolean           @default(false) @map("ics_share_enabled")
  userId          String            @map("user_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events          CalendarEvent[]
  sharedCalendars CalendarSharing[]
  subscriptions   CalendarSubscription[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@map("calendar")
}

model EventCategory {
  id        String          @id @default(cuid())
  name      String
  color     String // blue, orange, violet, rose, emerald
  isActive  Boolean         @default(true) @map("is_active")
  userId    String          @map("user_id")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    CalendarEvent[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@map("event_category")
}

model CalendarEvent {
  id                   String                @id @default(cuid())
  title                String
  description          String?
  start                DateTime
  end                  DateTime
  allDay               Boolean               @default(false) @map("all_day")
  location             String?
  color                String? // blue, orange, violet, rose, emerald
  timezone             String                @default("UTC") // IANA timezone identifier
  // Additional fields for a complete calendar app
  isPrivate            Boolean               @default(false) @map("is_private")
  reminder             Int? // minutes before event to remind
  recurrence           String? // JSON string for recurrence rules (daily, weekly, monthly, etc.)
  parentEventId        String?               @map("parent_event_id") // For recurring event instances
  // Sync fields for external calendar events
  isSynced             Boolean               @default(false) @map("is_synced") // Whether this event came from external calendar
  externalId           String?               @map("external_id") // UID from the .ics file
  subscriptionId       String?               @map("subscription_id") // Which subscription this event came from
  syncedAt             DateTime?             @map("synced_at") // When this event was last synced
  // Relationships
  userId               String                @map("user_id")
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarId           String                @map("calendar_id")
  calendar             Calendar              @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  categoryId           String?               @map("category_id")
  category             EventCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  participants         EventParticipant[]
  recurrenceExceptions RecurrenceException[]
  notifications        EventNotification[]
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@index([isSynced, subscriptionId])
  @@index([externalId, subscriptionId])
  @@map("calendar_event")
}

model EventParticipant {
  id        String        @id @default(cuid())
  eventId   String        @map("event_id")
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String        @default("pending") // pending, accepted, declined
  role      String        @default("attendee") // organizer, attendee
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@unique([eventId, userId])
  @@map("event_participant")
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Display preferences
  theme                String   @default("light") // light, dark, system
  defaultView          String   @default("week") // month, week, day, agenda
  weekStartDay         Int      @default(1) // 0 = Sunday, 1 = Monday
  // Time & Timezone
  timezone             String   @default("UTC") // IANA timezone identifier
  timeFormat           String   @default("24h") // 12h, 24h
  // Working hours (in minutes from midnight)
  workingHoursStart    Int      @default(540) // 9:00 AM = 540 minutes
  workingHoursEnd      Int      @default(1020) // 5:00 PM = 1020 minutes
  workingDays          String   @default("[1,2,3,4,5]") // JSON array of weekdays
  // Notification preferences
  emailNotifications   Boolean  @default(true)
  browserNotifications Boolean  @default(true)
  reminderSound        Boolean  @default(true)
  // Default event settings
  defaultReminder      Int? // Default reminder in minutes
  defaultEventDuration Int      @default(60) // Default event duration in minutes
  defaultCalendarId    String?  @map("default_calendar_id")
  // UI preferences
  compactView          Boolean  @default(false)
  showWeekNumbers      Boolean  @default(false)
  showDeclinedEvents   Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}

model CalendarSharing {
  id         String   @id @default(cuid())
  calendarId String   @map("calendar_id")
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  sharedWith String   @map("shared_with") // User ID
  sharedBy   String   @map("shared_by") // User ID
  permission String   @default("read") // read, write, admin
  accepted   Boolean  @default(false) // Whether the invitation was accepted
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([calendarId, sharedWith])
  @@map("calendar_sharing")
}

model RecurrenceException {
  id              String         @id @default(cuid())
  parentEventId   String         @map("parent_event_id") // ID of the original recurring event
  exceptionDate   DateTime       @map("exception_date") // The date this exception applies to
  modifiedEventId String?        @map("modified_event_id") // ID of the modified event (null if deleted)
  modifiedEvent   CalendarEvent? @relation(fields: [modifiedEventId], references: [id], onDelete: SetNull)
  type            String         @default("modified") // modified, deleted
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([parentEventId, exceptionDate])
  @@map("recurrence_exception")
}

model EventNotification {
  id               String        @id @default(cuid())
  eventId          String        @map("event_id")
  event            CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  notificationType String        @map("notification_type") // 'browser', 'email'
  minutesBefore    Int           @map("minutes_before")
  notificationTime DateTime      @map("notification_time") // Exact time to send notification
  notificationDateLocal String   @map("notification_date_local")
  notificationTimezone  String   @default("UTC") @map("notification_timezone")
  isEnabled        Boolean       @default(true) @map("is_enabled")
  isSent           Boolean       @default(false) @map("is_sent")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Optimized indexes for enhanced notification system
  @@index([notificationTime, isEnabled, isSent], name: "idx_event_notification_time_enabled_sent")
  @@index([eventId, notificationType], name: "idx_event_notification_event_type")
  @@index([isSent, createdAt], name: "idx_event_notification_sent_created")
  @@map("event_notification")
}

model NotificationLog {
  id               String   @id @default(cuid())
  eventId          String   @map("event_id")
  userId           String   @map("user_id")
  notificationType String   @map("notification_type") // 'browser', 'email'
  minutesBefore    Int      @map("minutes_before")
  sentAt           DateTime @map("sent_at")
  status           String   @default("sent") @map("status") // 'sent', 'failed', 'pending'
  createdAt        DateTime @default(now()) @map("created_at")

  // Enhanced indexes for notification log queries
  @@index([eventId, userId])
  @@index([sentAt, status], name: "idx_notification_log_sent_at_status")
  @@index([userId, sentAt], name: "idx_notification_log_user_sent")
  @@index([status, createdAt], name: "idx_notification_log_failed")
  @@map("notification_log")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@map("passkey")
}

// Calendar Subscription Models

model CalendarSubscription {
  id                String              @id @default(cuid())
  name              String              // User-friendly name for the subscription
  url               String              // .ics feed URL
  isActive          Boolean             @default(true) @map("is_active")
  syncIntervalMinutes Int               @default(15) @map("sync_interval_minutes")
  lastSyncAt        DateTime?           @map("last_sync_at")
  lastSyncStatus    String              @default("pending") @map("last_sync_status") // success, error, pending
  lastErrorMessage  String?             @map("last_error_message")
  etag              String?             // For HTTP caching
  lastModified      String?             @map("last_modified") // For HTTP caching
  
  // Relationships
  userId            String              @map("user_id")
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarId        String              @map("calendar_id")
  calendar          Calendar            @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  
  // Tracking
  syncLogs          CalendarSyncLog[]
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@unique([userId, url])
  @@index([isActive, lastSyncAt])
  @@map("calendar_subscription")
}

model CalendarSyncLog {
  id                    String                @id @default(cuid())
  subscriptionId        String                @map("subscription_id")
  subscription          CalendarSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  status                String                @default("started") // started, success, error
  eventsAdded           Int                   @default(0) @map("events_added")
  eventsUpdated         Int                   @default(0) @map("events_updated")
  eventsDeleted         Int                   @default(0) @map("events_deleted")
  errorMessage          String?               @map("error_message")
  syncDurationMs        Int?                  @map("sync_duration_ms")
  httpStatusCode        Int?                  @map("http_status_code")
  startedAt             DateTime              @default(now()) @map("started_at")
  completedAt           DateTime?             @map("completed_at")

  @@index([subscriptionId, startedAt])
  @@index([status, startedAt])
  @@map("calendar_sync_log")
}
