
generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

generator prismabox {
  provider                    = "prismabox"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
  inputModel                  = true
  output                      = "../generated/prismabox"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(cuid())
  name           String
  email          String             @unique
  emailVerified  Boolean            @default(false) @map("email_verified")
  image          String?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  sessions       Session[]
  accounts       Account[]
  // Calendar relationships
  events         CalendarEvent[]
  categories     EventCategory[]
  calendars      Calendar[]
  participations EventParticipant[]
  settings       UserSettings?
  subscriptions  CalendarSubscription[]
  mailDirectoryEntry MailDirectoryEntry?
  oauthClients   OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens OauthAccessToken[]
  oauthConsents  OauthConsent[]
  encryptionDevices UserEncryptionDevice[]
  encryptionPassword UserEncryptionPassword?

  passkeys Passkey[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens OauthAccessToken[]

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String    @unique
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("verification")
}

// Calendar Models

model Calendar {
  id              String            @id @default(cuid())
  name            String
  encryptedName   String?           @map("encrypted_name")
  blindIndexTokens String?          @map("blind_index_tokens")
  encryptionState String            @default("plaintext") @map("encryption_state")
  encryptionKeyVersion Int          @default(1) @map("encryption_key_version")
  forceFullEncryption Boolean       @default(false) @map("force_full_encryption")
  color           String // blue, orange, violet, rose, emerald
  kind            String            @default("owned") @map("kind") // owned, subscribed, public_holiday
  isPublic        Boolean           @default(false) @map("is_public")
  isVisible       Boolean           @default(true) @map("is_visible")
  isDefault       Boolean           @default(false) @map("is_default")
  isSyncOnly      Boolean           @default(false) @map("is_sync_only") // Read-only calendar synced from external subscription
  icsShareToken   String?           @unique @map("ics_share_token")
  icsShareEnabled Boolean           @default(false) @map("ics_share_enabled")
  userId          String            @map("user_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events          CalendarEvent[]
  sharedCalendars CalendarSharing[]
  subscriptions   CalendarSubscription[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@map("calendar")
}

model EventCategory {
  id        String          @id @default(cuid())
  name      String
  encryptedName String?     @map("encrypted_name")
  blindIndexTokens String?  @map("blind_index_tokens")
  encryptionState String    @default("plaintext") @map("encryption_state")
  encryptionKeyVersion Int  @default(1) @map("encryption_key_version")
  color     String // blue, orange, violet, rose, emerald
  isActive  Boolean         @default(true) @map("is_active")
  userId    String          @map("user_id")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    CalendarEvent[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@map("event_category")
}

model CalendarEvent {
  id                   String                @id @default(cuid())
  title                String
  description          String?
  encryptedContent     String?               @map("encrypted_content")
  blindIndexTokens     String?               @map("blind_index_tokens")
  encryptionState      String                @default("plaintext") @map("encryption_state")
  encryptionKeyVersion Int                   @default(1) @map("encryption_key_version")
  start                DateTime
  end                  DateTime
  allDay               Boolean               @default(false) @map("all_day")
  location             String?
  color                String? // blue, orange, violet, rose, emerald
  timezone             String                @default("UTC") // IANA timezone identifier
  // Additional fields for a complete calendar app
  isPrivate            Boolean               @default(false) @map("is_private")
  reminder             Int? // minutes before event to remind
  recurrence           String? // JSON string for recurrence rules (daily, weekly, monthly, etc.)
  parentEventId        String?               @map("parent_event_id") // For recurring event instances
  // Sync fields for external calendar events
  isSynced             Boolean               @default(false) @map("is_synced") // Whether this event came from external calendar
  externalId           String?               @map("external_id") // UID from the .ics file
  subscriptionId       String?               @map("subscription_id") // Which subscription this event came from
  syncedAt             DateTime?             @map("synced_at") // When this event was last synced
  // Relationships
  userId               String                @map("user_id")
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarId           String                @map("calendar_id")
  calendar             Calendar              @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  categoryId           String?               @map("category_id")
  category             EventCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  participants         EventParticipant[]
  recurrenceExceptions RecurrenceException[]
  notifications        EventNotification[]
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@index([isSynced, subscriptionId])
  @@index([externalId, subscriptionId])
  @@index([userId, start, end])
  @@index([userId, recurrence, parentEventId])
  @@map("calendar_event")
}

model EventParticipant {
  id        String        @id @default(cuid())
  eventId   String        @map("event_id")
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String        @default("pending") // pending, accepted, declined
  role      String        @default("attendee") // organizer, attendee
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@unique([eventId, userId])
  @@map("event_participant")
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Display preferences
  theme                String   @default("light") // light, dark, system
  defaultView          String   @default("week") // month, week, day, agenda
  weekStartDay         Int      @default(1) // 0 = Sunday, 1 = Monday
  // Time & Timezone
  timezone             String   @default("UTC") // IANA timezone identifier
  timeFormat           String   @default("24h") // 12h, 24h
  // Working hours (in minutes from midnight)
  workingHoursStart    Int      @default(540) // 9:00 AM = 540 minutes
  workingHoursEnd      Int      @default(1020) // 5:00 PM = 1020 minutes
  workingDays          String   @default("[1,2,3,4,5]") // JSON array of weekdays
  // Notification preferences
  emailNotifications   Boolean  @default(true)
  browserNotifications Boolean  @default(true)
  reminderSound        Boolean  @default(true)
  eventEncryptionMode  String   @default("hybrid") @map("event_encryption_mode") // hybrid, full
  // Default event settings
  defaultReminder      Int? // Default reminder in minutes
  defaultEventDuration Int      @default(60) // Default event duration in minutes
  defaultCalendarId    String?  @map("default_calendar_id")
  // UI preferences
  compactView          Boolean  @default(false)
  showWeekNumbers      Boolean  @default(false)
  showDeclinedEvents   Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}

model CalendarSharing {
  id         String   @id @default(cuid())
  calendarId String   @map("calendar_id")
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  sharedWith String   @map("shared_with") // User ID
  sharedBy   String   @map("shared_by") // User ID
  permission String   @default("read") // read, write, admin
  accepted   Boolean  @default(false) // Whether the invitation was accepted
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([calendarId, sharedWith])
  @@map("calendar_sharing")
}

model RecurrenceException {
  id              String         @id @default(cuid())
  parentEventId   String         @map("parent_event_id") // ID of the original recurring event
  exceptionDate   DateTime       @map("exception_date") // The date this exception applies to
  modifiedEventId String?        @map("modified_event_id") // ID of the modified event (null if deleted)
  modifiedEvent   CalendarEvent? @relation(fields: [modifiedEventId], references: [id], onDelete: SetNull)
  type            String         @default("modified") // modified, deleted
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([parentEventId, exceptionDate])
  @@map("recurrence_exception")
}

model EventNotification {
  id               String        @id @default(cuid())
  eventId          String        @map("event_id")
  event            CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  notificationType String        @map("notification_type") // 'browser', 'email'
  minutesBefore    Int           @map("minutes_before")
  notificationTime DateTime      @map("notification_time") // Exact time to send notification
  notificationDateLocal String   @map("notification_date_local")
  notificationTimezone  String   @default("UTC") @map("notification_timezone")
  isEnabled        Boolean       @default(true) @map("is_enabled")
  isSent           Boolean       @default(false) @map("is_sent")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Optimized indexes for enhanced notification system
  @@index([notificationTime, isEnabled, isSent], name: "idx_event_notification_time_enabled_sent")
  @@index([eventId, notificationType], name: "idx_event_notification_event_type")
  @@index([isSent, createdAt], name: "idx_event_notification_sent_created")
  @@map("event_notification")
}

model NotificationLog {
  id               String   @id @default(cuid())
  eventId          String   @map("event_id")
  userId           String   @map("user_id")
  notificationType String   @map("notification_type") // 'browser', 'email'
  minutesBefore    Int      @map("minutes_before")
  sentAt           DateTime @map("sent_at")
  status           String   @default("sent") @map("status") // 'sent', 'failed', 'pending'
  createdAt        DateTime @default(now()) @map("created_at")

  // Enhanced indexes for notification log queries
  @@index([eventId, userId])
  @@index([sentAt, status], name: "idx_notification_log_sent_at_status")
  @@index([userId, sentAt], name: "idx_notification_log_user_sent")
  @@index([status, createdAt], name: "idx_notification_log_failed")
  @@map("notification_log")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@map("passkey")
}

model Jwks {
  id         String    @id @default(cuid())
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                     String               @id @default(cuid())
  clientId               String               @unique @map("client_id")
  clientSecret           String?              @map("client_secret")
  disabled               Boolean              @default(false)
  skipConsent            Boolean?             @map("skip_consent")
  enableEndSession       Boolean?             @map("enable_end_session")
  subjectType            String?              @map("subject_type")
  scopes                 String[]             @default([])
  userId                 String?              @map("user_id")
  user                   User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  name                   String?
  uri                    String?
  icon                   String?
  contacts               String[]             @default([])
  tos                    String?
  policy                 String?
  softwareId             String?              @map("software_id")
  softwareVersion        String?              @map("software_version")
  softwareStatement      String?              @map("software_statement")
  redirectUris           String[]             @map("redirect_uris")
  postLogoutRedirectUris String[]             @default([]) @map("post_logout_redirect_uris")
  tokenEndpointAuthMethod String?             @map("token_endpoint_auth_method")
  grantTypes             String[]             @default([]) @map("grant_types")
  responseTypes          String[]             @default([]) @map("response_types")
  public                 Boolean?
  type                   String?
  requirePKCE            Boolean?             @map("require_pkce")
  referenceId            String?              @map("reference_id")
  metadata               Json?
  refreshTokens          OauthRefreshToken[]
  accessTokens           OauthAccessToken[]
  consents               OauthConsent[]

  @@index([userId])
  @@index([referenceId])
  @@map("oauth_client")
}

model OauthRefreshToken {
  id           String               @id @default(cuid())
  token        String               @unique
  clientId     String               @map("client_id")
  client       OauthClient          @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId     String?             @map("session_id")
  session       Session?            @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId       String               @map("user_id")
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId  String?              @map("reference_id")
  expiresAt    DateTime             @map("expires_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  revoked      DateTime?
  authTime     DateTime?            @map("auth_time")
  scopes       String[]             @default([])
  accessTokens OauthAccessToken[]   @relation("OauthAccessTokenRefresh")

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id          String              @id @default(cuid())
  token       String              @unique
  clientId    String              @map("client_id")
  client      OauthClient         @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId   String?             @map("session_id")
  session     Session?            @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId      String?             @map("user_id")
  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?             @map("reference_id")
  refreshId   String?             @map("refresh_id")
  refresh     OauthRefreshToken?  @relation("OauthAccessTokenRefresh", fields: [refreshId], references: [id], onDelete: SetNull)
  expiresAt   DateTime            @map("expires_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  scopes      String[]            @default([])

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id         String       @id @default(cuid())
  clientId   String       @map("client_id")
  client     OauthClient  @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId     String?      @map("user_id")
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?     @map("reference_id")
  scopes     String[]     @default([])
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([clientId, userId])
  @@index([referenceId])
  @@map("oauth_consent")
}

model UserEncryptionDevice {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId           String   @map("device_id")
  deviceLabel        String?  @map("device_label")
  publicKey          String   @map("public_key")
  publicKeyAlgorithm String   @default("RSA-OAEP-256") @map("public_key_algorithm")
  wrappedAccountKey  String   @map("wrapped_account_key")
  wrappedSearchKey   String   @map("wrapped_search_key")
  wrapAlgorithm      String   @default("RSA-OAEP-256") @map("wrap_algorithm")
  keyVersion         Int      @default(1) @map("key_version")
  lastSeenAt         DateTime @default(now()) @map("last_seen_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([userId, deviceId])
  @@index([userId, lastSeenAt])
  @@map("user_encryption_device")
}

model UserEncryptionPassword {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kdfAlgorithm      String   @default("PBKDF2-SHA-256") @map("kdf_algorithm")
  kdfSalt           String   @map("kdf_salt")
  kdfIterations     Int      @default(310000) @map("kdf_iterations")
  wrappedAccountKey String   @map("wrapped_account_key")
  wrappedSearchKey  String   @map("wrapped_search_key")
  wrapAlgorithm     String   @default("AES-GCM-256") @map("wrap_algorithm")
  keyVersion        Int      @default(1) @map("key_version")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("user_encryption_password")
}

model MailDirectoryEntry {
  id                   String          @id @default(cuid())
  userId               String?         @unique @map("user_id")
  user                 User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                String          @unique
  localPart            String          @map("local_part")
  domain               String
  displayName          String?         @map("display_name")
  stalwartAccountId    String          @unique @map("stalwart_account_id")
  stalwartDomainId     String          @map("stalwart_domain_id")
  stalwartPublicKeyId  String?         @map("stalwart_public_key_id")
  publicKeyArmored     String          @map("public_key_armored")
  publicKeyFingerprint String          @map("public_key_fingerprint")
  keyAlgorithm         String          @default("openpgp") @map("key_algorithm")
  source               String          @default("internal")
  trust                String          @default("verified")
  keyCreatedAt         DateTime?       @map("key_created_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  vaultBackup          MailVaultBackup?
  mailSyncState        MailJmapSyncState?

  @@index([domain, localPart])
  @@map("mail_directory_entry")
}

model MailVaultBackup {
  id                String            @id @default(cuid())
  directoryEntryId  String            @unique @map("directory_entry_id")
  directoryEntry    MailDirectoryEntry @relation(fields: [directoryEntryId], references: [id], onDelete: Cascade)
  vaultVersion      Int               @map("vault_version")
  encryptedVaultB64 String            @map("encrypted_vault_b64")
  kdf               String
  kdfSaltB64        String            @map("kdf_salt_b64")
  kdfMemoryKiB      Int               @map("kdf_memory_kib")
  kdfIterations     Int               @map("kdf_iterations")
  kdfParallelism    Int               @map("kdf_parallelism")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@map("mail_vault_backup")
}

model MailJmapSyncState {
  id               String             @id @default(cuid())
  directoryEntryId String             @unique @map("directory_entry_id")
  directoryEntry   MailDirectoryEntry @relation(fields: [directoryEntryId], references: [id], onDelete: Cascade)
  stalwartAccountId String            @unique @map("stalwart_account_id")
  emailState       String             @map("email_state")
  mailboxState     String             @map("mailbox_state")
  threadState      String?            @map("thread_state")
  lastSyncedAt     DateTime?          @map("last_synced_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@map("mail_jmap_sync_state")
}

// Calendar Subscription Models

model CalendarSubscription {
  id                String              @id @default(cuid())
  name              String              // User-friendly name for the subscription
  url               String              // .ics feed URL
  isActive          Boolean             @default(true) @map("is_active")
  syncIntervalMinutes Int               @default(15) @map("sync_interval_minutes")
  lastSyncAt        DateTime?           @map("last_sync_at")
  lastSyncStatus    String              @default("pending") @map("last_sync_status") // success, error, pending
  lastErrorMessage  String?             @map("last_error_message")
  etag              String?             // For HTTP caching
  lastModified      String?             @map("last_modified") // For HTTP caching
  
  // Relationships
  userId            String              @map("user_id")
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarId        String              @map("calendar_id")
  calendar          Calendar            @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  
  // Tracking
  syncLogs          CalendarSyncLog[]
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@unique([userId, url])
  @@index([isActive, lastSyncAt])
  @@map("calendar_subscription")
}

model CalendarSyncLog {
  id                    String                @id @default(cuid())
  subscriptionId        String                @map("subscription_id")
  subscription          CalendarSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  status                String                @default("started") // started, success, error
  eventsAdded           Int                   @default(0) @map("events_added")
  eventsUpdated         Int                   @default(0) @map("events_updated")
  eventsDeleted         Int                   @default(0) @map("events_deleted")
  errorMessage          String?               @map("error_message")
  syncDurationMs        Int?                  @map("sync_duration_ms")
  httpStatusCode        Int?                  @map("http_status_code")
  startedAt             DateTime              @default(now()) @map("started_at")
  completedAt           DateTime?             @map("completed_at")

  @@index([subscriptionId, startedAt])
  @@index([status, startedAt])
  @@map("calendar_sync_log")
}
