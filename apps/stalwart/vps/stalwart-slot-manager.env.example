# /etc/stalwart-slot-manager.env — not deployed automatically; copy manually on the VPS.
SLOT_MANAGER_TOKEN=replace-with-shared-bearer-token

# Stalwart /metrics/prometheus basic auth (same credentials as Gatus prometheus_user/password).
PROMETHEUS_USER=prometheus
PROMETHEUS_PASSWORD=replace-me

# Or supply a pre-encoded "user:password" token instead of the pair above:
# PROMETHEUS_BASIC_AUTH=base64-without-Basic-prefix
