diff --git a/src/hooks/useSharedValueState.tsx b/src/hooks/useSharedValueState.tsx
new file mode 100644
index 0000000..8b4fcc1
--- /dev/null
+++ b/src/hooks/useSharedValueState.tsx
@@ -0,0 +1,20 @@
+import { useState } from 'react';
+import type { SharedValue } from 'react-native-reanimated';
+import { runOnJS, useAnimatedReaction } from 'react-native-reanimated';
+
+/** Mirrors a shared value into React state so it can drive plain layout styles, which RN 0.85+ drops from animated styles. */
+export const useSharedValueState = <T,>(sharedValue: SharedValue<T>): T => {
+  const [value, setValue] = useState<T>(() => sharedValue.value);
+
+  useAnimatedReaction(
+    () => sharedValue.value,
+    (next, prev) => {
+      if (next !== prev) {
+        runOnJS(setValue)(next);
+      }
+    },
+    [sharedValue]
+  );
+
+  return value;
+};
diff --git a/src/utils/allDayPageLayout.ts b/src/utils/allDayPageLayout.ts
new file mode 100644
index 0000000..981919e
--- /dev/null
+++ b/src/utils/allDayPageLayout.ts
@@ -0,0 +1,97 @@
+type DateOrDateTimeLike =
+  | { date: string; dateTime?: never; timeZone?: never }
+  | { dateTime: string; timeZone?: string; date?: never };
+
+// Structural mirror of PackedAllDayEvent so this file stays free of imports.
+export interface PackedAllDayEventLike extends Record<string, any> {
+  id: string;
+  localId: string;
+  start: DateOrDateTimeLike;
+  end: DateOrDateTimeLike;
+  _internal: {
+    startUnix: number;
+    endUnix: number;
+    duration: number;
+    startMinutes?: number;
+    weekStart?: number;
+    resourceIndex?: number;
+    rowIndex: number;
+    totalRows: number;
+    startIndex: number;
+    columnSpan: number;
+  };
+}
+
+/** Re-packs all-day events against the page's own columns; the store packs per week, which breaks pages that don't start on the week start. */
+export const layoutAllDayEventsForPage = (
+  events: PackedAllDayEventLike[],
+  pageDays: number[]
+): PackedAllDayEventLike[] => {
+  const mergedById = new Map<string, PackedAllDayEventLike>();
+  for (const event of events) {
+    const existing = mergedById.get(event.id);
+    if (!existing) {
+      mergedById.set(event.id, event);
+      continue;
+    }
+    mergedById.set(event.id, {
+      ...existing,
+      _internal: {
+        ...existing._internal,
+        startUnix: Math.min(
+          existing._internal.startUnix,
+          event._internal.startUnix
+        ),
+        endUnix: Math.max(existing._internal.endUnix, event._internal.endUnix),
+      },
+    });
+  }
+
+  const placed: {
+    event: PackedAllDayEventLike;
+    startIndex: number;
+    columnSpan: number;
+  }[] = [];
+  for (const event of mergedById.values()) {
+    const { startUnix, endUnix } = event._internal;
+    let first = -1;
+    let last = -1;
+    pageDays.forEach((dayUnix, index) => {
+      if (dayUnix >= startUnix && dayUnix <= endUnix) {
+        if (first === -1) {
+          first = index;
+        }
+        last = index;
+      }
+    });
+    if (first !== -1) {
+      placed.push({ event, startIndex: first, columnSpan: last - first + 1 });
+    }
+  }
+
+  placed.sort(
+    (a, b) => a.startIndex - b.startIndex || b.columnSpan - a.columnSpan
+  );
+
+  const rowEnds: number[] = [];
+  const packed = placed.map(({ event, startIndex, columnSpan }) => {
+    let rowIndex = rowEnds.findIndex((end) => end < startIndex);
+    if (rowIndex === -1) {
+      rowIndex = rowEnds.length;
+      rowEnds.push(0);
+    }
+    rowEnds[rowIndex] = startIndex + columnSpan - 1;
+    return { event, startIndex, columnSpan, rowIndex };
+  });
+
+  return packed.map(({ event, startIndex, columnSpan, rowIndex }) => ({
+    ...event,
+    _internal: {
+      ...event._internal,
+      startIndex,
+      columnSpan,
+      rowIndex,
+      totalRows: rowEnds.length,
+    },
+  }));
+};
