# jevlint (bun run lint:jev) sends source code units to Cloudflare Workers AI (clef).
# Copy to .env (gitignored; loaded by scripts/jevlint.ts when the lint:jev scripts run) or export from your shell.
# CLOUDFLARE_ACCOUNT_ID: Workers AI dashboard page or its URL.
# CLOUDFLARE_AUTH_TOKEN: Workers AI API token with Workers AI Read + Edit permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
