{
  "$schema": "https://react.doctor/schema/config.json",
  "diff": true,
  "blocking": "warning",
  "noScore": true,
  "verbose": true,
  "ignore": {
    "overrides": [
      {
        "files": ["**/providers/AuthProvider.tsx"],
        "rules": [
          "react-doctor/no-giant-component",
          "react-doctor/no-set-state-after-await-in-effect"
        ]
      },
      {
        "files": ["**/providers/E2eeProvider.tsx"],
        "rules": ["react-doctor/no-giant-component"]
      },
      {
        "files": ["**/components/mail/AttachmentPreviewModal.tsx"],
        "rules": ["react-doctor/rn-prefer-expo-image"]
      },
      {
        "files": ["**/app/login/_content.tsx"],
        "rules": ["react-doctor/no-giant-component"]
      },
      {
        "files": ["**/app/login/login-form-entry.tsx"],
        "rules": ["react-doctor/nextjs-no-use-search-params-without-suspense"]
      },
      {
        "files": ["**/components/event-editor.tsx"],
        "rules": [
          "react-doctor/no-event-handler",
          "react-doctor/no-pass-data-to-parent",
          "react-doctor/no-cascading-set-state"
        ]
      },
      {
        "files": ["**/components/event-editor/event-editor-preview.ts"],
        "rules": [
          "react-doctor/no-event-handler",
          "react-doctor/no-pass-data-to-parent",
          "react-doctor/no-prop-callback-in-effect"
        ]
      },
      {
        "files": ["**/components/mail/compose-dialog.tsx"],
        "rules": [
          "react-doctor/no-giant-component",
          "react-doctor/no-event-handler",
          "react-doctor/no-danger"
        ]
      },
      {
        "files": ["**/components/calendar/calendar-dnd-context.tsx"],
        "rules": [
          "react-doctor/no-giant-component",
          "react-doctor/prefer-useReducer"
        ]
      },
      {
        "files": ["**/lib/notification-calculator.ts"],
        "rules": ["react-doctor/js-hoist-intl"]
      },
      {
        "files": ["**/app/settings/index.tsx", "**/app/calendar-manage/index.tsx"],
        "rules": ["react-doctor/js-tosorted-immutable"]
      },
      {
        "files": [
          "**/services/event.service.ts",
          "**/services/event-participant.service.ts",
          "**/services/mail-sync.service.ts"
        ],
        "rules": ["react-doctor/async-await-in-loop"]
      },
      {
        "files": ["**/components/mail/message-list/message-list-virtualized.tsx"],
        "rules": [
          "react-hooks-js/incompatible-library",
          "react-doctor/no-event-handler"
        ]
      },
      {
        "files": ["**/components/mail/message-list/message-list-row.tsx"],
        "rules": ["react-doctor/prefer-tag-over-role"]
      }
    ]
  }
}
