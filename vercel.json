{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }],
  "env": { "PORT": "8080" },
  "regions": ["fra1"]
}
