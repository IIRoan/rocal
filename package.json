{
  "name": "rocal",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter='*' build",
    "dev": "bun run --filter='web' dev & bun run --filter='backend' dev & bun run --filter='notifications' dev",
    "dev:frontend": "bun run --filter='web' dev",
    "dev:backend": "bun run --filter='backend' dev",
    "dev:notifications": "bun run --filter='notifications' dev",
    "lint": "bun run --filter='*' lint",
    "typecheck": "bun run --filter='*' typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "minimatch": "^10.1.1",
    "prettier": "^3.7.4",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0"
  }
}
