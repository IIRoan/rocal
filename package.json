{
  "name": "solace",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "cd apps/backend && bun install && cd ../web && bun install && cd ../notifications && bun install",
    "build": "cd apps/backend && bun run build && cd ../web && bun run build && cd ../notifications && bun run build",
    "build:backend": "cd apps/backend && bun run build",
    "start:backend": "cd apps/backend && ./server",
    "build:web": "cd apps/web && bun run build",
    "build:notifications": "cd apps/notifications && bun run build",
    "start:notifications": "cd apps/notifications && ./notifications",
    "dev": "cd apps/backend && bun run dev & cd apps/web && bun run dev & cd apps/notifications && bun run dev",
    "dev:frontend": "cd apps/web && bun run dev",
    "dev:backend": "cd apps/backend && bun run dev",
    "dev:native": "cd apps/native && bun run dev",
    "cloudflared": "bun run ./scripts/cloudflared.ts",
    "dev:notifications": "cd apps/notifications && bun run dev",
    "lint": "cd apps/backend && bun run lint && cd ../web && bun run lint && cd ../notifications && bun run lint",
    "lint:react-doctor": "bun run --cwd apps/web lint:react-doctor && bun run --cwd packages/ui lint:react-doctor",
    "typecheck": "cd apps/backend && bun run typecheck && cd ../web && bun run typecheck && cd ../notifications && bun run typecheck",
    "typecheck:native": "cd apps/native && bun run typecheck",
    "test": "bun run scripts/run-tests.ts",
    "test:coverage": "bun run scripts/run-tests.ts --coverage",
    "test:backend": "cd apps/backend && bun run test",
    "test:backend:coverage": "cd apps/backend && bun run test:coverage",
    "test:ui": "cd packages/ui && bun run test",
    "test:ui:coverage": "cd packages/ui && bun run test:coverage",
    "test:native": "cd apps/native && bun run test",
    "test:notifications": "cd apps/notifications && bun run test",
    "test:notifications:coverage": "cd apps/notifications && bun run test:coverage",
    "test:ci": "bun run scripts/run-tests.ts --coverage",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@babel/preset-react": "^7.28.5",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "babel-preset-jest": "^30.4.0",
    "bun-types": "^1.3.14",
    "minimatch": "10.1.1",
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.5.5",
    "@phosphor-icons/react": "2.1.10",
    "babel-jest": "^30.4.1",
    "jest-environment-jsdom": "30.3.0"
  }
}
