{
  "name": "solace",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "bun install",
    "build": "cd apps/backend && bun run build && cd ../web && bun run build && cd ../notifications && bun run build",
    "build:backend": "cd apps/backend && bun run build",
    "start:backend": "cd apps/backend && ./server",
    "build:web": "cd apps/web && bun run build",
    "build:notifications": "cd apps/notifications && bun run build",
    "start:notifications": "cd apps/notifications && ./notifications",
    "dev": "cd apps/backend && bun run dev & cd apps/web && bun run dev & cd apps/notifications && bun run dev & cd apps/mobile && bun run start",
    "dev:frontend": "cd apps/web && bun run dev",
    "dev:backend": "cd apps/backend && bun run dev",
    "dev:notifications": "cd apps/notifications && bun run dev",
    "dev:mobile": "cd apps/mobile && bun run start",
    "lint": "bun scripts/run-workspaces.ts lint",
    "lint:mobile": "cd apps/mobile && bun run lint",
    "typecheck": "bun scripts/run-workspaces.ts typecheck",
    "typecheck:mobile": "cd apps/mobile && bun run typecheck",
    "check": "bun scripts/run-workspaces.ts lint && bun scripts/run-workspaces.ts typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "minimatch": "^10.1.1",
    "prettier": "^3.7.4",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10"
  }
}
