{
  "name": "solace",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "cd apps/web && bun run build && cargo build --release -p solace-server -p solace-notifications",
    "build:backend": "cargo build --release -p solace-server",
    "start:backend": "./target/release/solace-server",
    "build:web": "cd apps/web && bun run build",
    "build:notifications": "cargo build --release -p solace-notifications",
    "start:notifications": "./target/release/solace-notifications",
    "dev": "cargo run -p solace-server & cd apps/web && bun run dev & cargo run -p solace-notifications",
    "dev:web": "cd apps/web && bun run dev",
    "dev:backend": "cargo run -p solace-server",
    "dev:calendar": "cd apps/native-calendar && bun run dev",
    "dev:mail": "cd apps/native-mail && bun run dev",
    "dev:mobile": "bun run ./scripts/dev-mobile.ts",
    "cloudflared": "bun run ./scripts/cloudflared.ts",
    "dev:notifications": "cargo run -p solace-notifications",
    "lint": "bun run check:rules && cd apps/web && bun run lint && cd ../native-calendar && bun run lint && cd ../native-mail && bun run lint && cd ../../packages/native-core && bun run lint",
    "check:rules": "bun run scripts/check-repo-rules.ts",
    "lint:react-doctor": "bun run --cwd apps/web lint:react-doctor && bun run --cwd packages/ui lint:react-doctor",
    "typecheck": "cd apps/web && bun run typecheck",
    "typecheck:native": "cd packages/native-core && bun run typecheck && cd ../../apps/native-calendar && bun run typecheck && cd ../native-mail && bun run typecheck",
    "test": "bun run scripts/run-tests.ts",
    "test:coverage": "bun run scripts/run-tests.ts --coverage",
    "test:backend": "cargo test -p solace-server",
    "test:ui": "cd packages/ui && bun run test",
    "test:ui:coverage": "cd packages/ui && bun run test:coverage",
    "test:native": "cd packages/native-core && bun run test && cd ../../apps/native-calendar && bun run test && cd ../native-mail && bun run test",
    "test:notifications": "cargo test -p solace-notifications",
    "test:ci": "bun run scripts/run-tests.ts --coverage",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.29.7",
    "babel-jest": "^30.4.1",
    "babel-preset-jest": "^30.4.0",
    "bun-types": "^1.4.3",
    "jest-environment-jsdom": "30.3.0",
    "prettier": "3.7.4",
    "railway": "^3.11.0",
    "react-doctor": "^0.2.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1",
    "bun": ">=1.4.4"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "expo-constants": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "eslint-plugin-sonarjs": {
      "minimatch": "10.2.6"
    },
    "effect": {
      "toml": "5.0.1"
    },
    "xcode": {
      "uuid": "11.1.1"
    },
    "query-string": {
      "decode-uri-component": "0.5.0"
    }
  },
  "patchedDependencies": {
    "@howljs/calendar-kit@2.5.6": "patches/@howljs%2Fcalendar-kit@2.5.6.patch",
    "better-auth@1.7.7": "patches/better-auth@1.7.7.patch",
    "query-string@7.1.3": "patches/query-string@7.1.3.patch",
    "expo-image-picker@57.0.20": "patches/expo-image-picker@57.0.20.patch"
  }
}
